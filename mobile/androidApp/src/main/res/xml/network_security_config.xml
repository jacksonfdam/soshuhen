<?xml version="1.0" encoding="utf-8"?>
<!-- The server is reached at its LAN IP over plain HTTP: the HTTPS name the
     user's computer knows it by does not resolve on the phone. A domain-config
     cannot match an IP range, so cleartext is allowed app-wide; the app talks
     to nothing but that server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
