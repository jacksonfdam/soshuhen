<?xml version="1.0" encoding="utf-8"?>
<!-- Android reads these before any Kotlin runs, so these colours cannot come
     from Tokens.kt. They are Tokens.background. -->
<resources>
    <style name="Theme.Soshuhen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>

    <style name="Theme.Soshuhen.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Soshuhen</item>
    </style>
</resources>
